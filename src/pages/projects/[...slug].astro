---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project: CollectionEntry<'projects'>) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();
const isComingSoon = project.data.comingSoon;
---

<Layout title={`${project.data.title} — Piaw CAVAREC`} description={project.data.description}>
  <article class="shell py-10 sm:py-14">
    <!-- Retour & statut -->
    <div class="mb-8 flex flex-wrap items-center justify-between gap-3">
      <a href="/projects" class="inline-flex items-center gap-2 font-mono text-xs text-ink-400 transition-colors hover:text-signal-400">
        <span aria-hidden="true">←</span> Retour aux projets
      </a>

      {isComingSoon && (
        <span class="chip-amber">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amberlab"></span>
          <span>Bientôt disponible</span>
        </span>
      )}
    </div>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-14">
      <div class="min-w-0">
        <!-- En-tête éditorial -->
        <header class="mb-10 space-y-5">
          {project.data.categories.length > 0 && (
            <div class="eyebrow flex-wrap">
              <span class="eyebrow-num">//</span>
              <span>{project.data.categories.join(' · ')}</span>
            </div>
          )}
          <h1 class="text-balance font-display text-3xl font-semibold leading-tight text-ink-100 sm:text-4xl lg:text-5xl">
            {project.data.title}
          </h1>
          <p class="max-w-3xl text-base leading-relaxed text-ink-300 sm:text-lg">
            {project.data.description}
          </p>
        </header>

        {isComingSoon ? (
          <!-- Vue « en cours » -->
          <div class="space-y-8">
            <div class="rounded-xl border border-amberlab/25 bg-amberlab-900/60 p-4 font-mono text-xs leading-relaxed text-amberlab">
              ⚡ <strong>Projet en cours de réalisation au lab :</strong> La documentation technique complète, les schémas d'expérimentation et le rapport d'analyse seront publiés prochainement.
            </div>

            <div class="space-y-8 pt-2">
              <div class="space-y-3">
                <div class="h-5 w-2/5 animate-pulse rounded border border-ink-800 bg-ink-900"></div>
                <div class="space-y-2 pt-2">
                  <div class="h-3.5 w-full animate-pulse rounded bg-ink-900"></div>
                  <div class="h-3.5 w-11/12 animate-pulse rounded bg-ink-900"></div>
                  <div class="h-3.5 w-4/5 animate-pulse rounded bg-ink-900"></div>
                </div>
              </div>

              <div class="h-36 animate-pulse space-y-3 rounded-xl border border-ink-800 bg-ink-900/70 p-4">
                <div class="h-3 w-1/3 rounded bg-ink-800"></div>
                <div class="h-3 w-3/4 rounded bg-ink-800/70"></div>
                <div class="h-3 w-1/2 rounded bg-ink-800/60"></div>
                <div class="h-3 w-2/3 rounded bg-ink-800/80"></div>
              </div>

              <div class="space-y-3">
                <div class="h-5 w-1/3 animate-pulse rounded border border-ink-800 bg-ink-900"></div>
                <div class="space-y-2 pt-2">
                  <div class="h-3.5 w-full animate-pulse rounded bg-ink-900"></div>
                  <div class="h-3.5 w-5/6 animate-pulse rounded bg-ink-900"></div>
                  <div class="h-3.5 w-3/4 animate-pulse rounded bg-ink-900"></div>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <!-- Contenu Markdown -->
          <div class="prose prose-invert prose-lab max-w-none prose-headings:font-display prose-headings:font-semibold prose-headings:tracking-tight prose-h2:text-2xl prose-pre:bg-ink-900">
            <Content />
          </div>
        )}
      </div>

      <!-- Fiche technique du projet -->
      <aside class="order-first lg:order-none">
        <div class="card overflow-hidden lg:sticky lg:top-24">
          <div class="border-b border-ink-800 px-5 py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-500">
            Fiche projet
          </div>
          <dl class="divide-y divide-ink-800/80 font-mono text-xs">
            <div class="space-y-1 px-5 py-3.5">
              <dt class="uppercase tracking-wider text-ink-500">Année</dt>
              <dd class="text-ink-100">{project.data.year}</dd>
            </div>
            <div class="space-y-1 px-5 py-3.5">
              <dt class="uppercase tracking-wider text-ink-500">Contexte</dt>
              <dd class="leading-relaxed text-ink-100">{project.data.role}</dd>
            </div>
            <div class="space-y-2 px-5 py-3.5">
              <dt class="uppercase tracking-wider text-ink-500">Stack</dt>
              <dd class="flex flex-wrap gap-1.5">
                {project.data.stack.map((item: string) => (
                  <span class="chip">{item}</span>
                ))}
              </dd>
            </div>
            {(project.data.repoUrl || project.data.liveUrl) && (
              <div class="space-y-2 px-5 py-3.5">
                <dt class="uppercase tracking-wider text-ink-500">Liens</dt>
                <dd class="flex flex-col gap-2">
                  {project.data.repoUrl && (
                    <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost justify-between">
                      <span>GitHub</span><span aria-hidden="true">↗</span>
                    </a>
                  )}
                  {project.data.liveUrl && (
                    <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="btn-primary justify-between">
                      <span>Documentation / Démo</span><span aria-hidden="true">↗</span>
                    </a>
                  )}
                </dd>
              </div>
            )}
          </dl>
        </div>
      </aside>
    </div>
  </article>

  <script>
    const renderMermaid = async () => {
      // Find all pre elements generated by Astro/Shiki for mermaid code blocks
      const allPres = document.querySelectorAll('pre');
      const mermaidPres: HTMLPreElement[] = [];

      allPres.forEach((pre) => {
        const lang = pre.getAttribute('data-language');
        const codeChild = pre.querySelector('code');
        const codeClass = codeChild ? codeChild.className : '';
        if (lang === 'mermaid' || codeClass.includes('language-mermaid')) {
          mermaidPres.push(pre);
        }
      });

      if (mermaidPres.length === 0) return;

      // Dynamically import Mermaid only when diagrams exist on the page
      const mermaid = (await import('mermaid')).default;

      mermaid.initialize({
        startOnLoad: false,
        theme: 'dark',
        themeVariables: {
          darkMode: true,
          background: '#0a0b0a',
          primaryColor: '#1d211d',
          primaryTextColor: '#eef1ec',
          primaryBorderColor: '#76ad22',
          lineColor: '#8c938b',
          secondaryColor: '#161916',
          tertiaryColor: '#0a0b0a',
          mainBkg: '#161916',
          nodeBorder: '#3b413b',
          clusterBkg: '#111311',
          clusterBorder: '#2a2f2a',
          titleColor: '#eef1ec',
          edgeLabelBackground: '#161916',
          fontFamily: 'Inter, system-ui, sans-serif',
          fontSize: '13px',
        },
        flowchart: {
          useMaxWidth: false,
          htmlLabels: true,
          curve: 'basis',
        },
        securityLevel: 'loose',
      });

      let idCounter = 0;
      for (const pre of mermaidPres) {
        const rawCode = pre.textContent || '';
        if (!rawCode.trim()) continue;

        const id = `mermaid-svg-${Date.now()}-${idCounter++}`;
        const container = document.createElement('div');
        container.className =
          'mermaid-wrapper not-prose my-8 p-4 sm:p-6 rounded-xl bg-ink-900/70 border border-ink-800 overflow-x-auto flex justify-center items-center';

        try {
          const { svg } = await mermaid.render(id, rawCode);
          container.innerHTML = svg;
          const svgEl = container.querySelector('svg');
          if (svgEl) {
            svgEl.style.maxWidth = '100%';
            svgEl.style.height = 'auto';
            svgEl.style.display = 'block';
            svgEl.style.margin = '0 auto';
          }
          pre.replaceWith(container);
        } catch (err) {
          console.error('Erreur lors du rendu Mermaid:', err);
        }
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMermaid);
    } else {
      renderMermaid();
    }
  </script>
</Layout>


