---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allProjects: CollectionEntry<'projects'>[] = await getCollection('projects');

// Separate completed projects: featured first (alphabetical) then others (alphabetical)
const featuredCompletedProjects = allProjects
  .filter((p: CollectionEntry<'projects'>) => !p.data.comingSoon && p.data.featured)
  .sort((a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) => 
    a.data.title.localeCompare(b.data.title, 'fr', { sensitivity: 'base' })
  );

const otherCompletedProjects = allProjects
  .filter((p: CollectionEntry<'projects'>) => !p.data.comingSoon && !p.data.featured)
  .sort((a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) => 
    a.data.title.localeCompare(b.data.title, 'fr', { sensitivity: 'base' })
  );

const completedProjects = [...featuredCompletedProjects, ...otherCompletedProjects];

const comingSoonProjects = allProjects
  .filter((p: CollectionEntry<'projects'>) => p.data.comingSoon)
  .sort((a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) => 
    a.data.title.localeCompare(b.data.title, 'fr', { sensitivity: 'base' })
  );

const filterCategories = [
  "Hardware & Embarqué",
  "DevSecOps / DevOps",
  "Cloud & Identité",
  "Cyber & Reverse"
];
---

<Layout title="Tous les Projets — Piaw CAVAREC" description="Index complet de mes projets d'ingénierie, sécurité embarquée, cloud et DevSecOps.">
  <div class="shell space-y-10 py-10 sm:space-y-14 sm:py-16">
    <!-- En-tête -->
    <header class="space-y-6">
      <div class="space-y-3">
        <div class="eyebrow"><span class="eyebrow-num">//</span><span>Index</span></div>
        <h1 class="font-display text-4xl font-semibold text-ink-100 sm:text-5xl">
          Projets & Réalisations
        </h1>
      </div>

      <!-- Filtres -->
      <div class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
        <div class="inline-flex gap-1 rounded-full border border-ink-800 bg-ink-900/70 p-1 font-mono text-xs" id="filterBar" role="group" aria-label="Filtrer par catégorie">
          <button data-category="all" aria-pressed="true" class="filter-btn is-active">
            Tous
          </button>
          {filterCategories.map((cat) => (
            <button data-category={cat} aria-pressed="false" class="filter-btn">
              {cat}
            </button>
          ))}
        </div>
      </div>
    </header>

    <!-- Projets réalisés -->
    <section class="space-y-5" id="completedSection">
      <h2 class="flex items-center gap-2 border-b border-ink-800 pb-3 font-mono text-xs uppercase tracking-[0.18em] text-ink-400">
        <span>Projets Réalisés</span>
        <span class="text-ink-600">({completedProjects.length})</span>
      </h2>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2" id="completedList">
        {completedProjects.map((project: CollectionEntry<'projects'>) => (
          <a
            href={`/projects/${project.slug}`}
            data-categories={JSON.stringify(project.data.categories)}
            class="project-item card card-link card-ticks group flex flex-col p-5 sm:p-6"
          >
            <div class="mb-3 flex items-center justify-between gap-2 font-mono text-[11px] text-ink-500">
              <span class="min-w-0 truncate">{project.data.categories.join(' · ')}</span>
              <span class="flex shrink-0 items-center gap-2">
                {project.data.featured && <span class="chip-accent py-0">Vedette</span>}
                <span>{project.data.year}</span>
              </span>
            </div>

            <h3 class="mb-2.5 text-balance font-display text-lg font-semibold leading-snug text-ink-100 transition-colors group-hover:text-signal-300">
              {project.data.title}
            </h3>

            <p class="mb-5 text-sm leading-relaxed text-ink-400 transition-colors group-hover:text-ink-300">
              {project.data.description}
            </p>

            <div class="mt-auto flex items-end justify-between gap-3">
              <div class="flex flex-wrap gap-1.5">
                {project.data.stack.slice(0, 5).map((tech: string) => (
                  <span class="chip">{tech}</span>
                ))}
                {project.data.stack.length > 5 && (
                  <span class="px-1 py-0.5 font-mono text-[11px] text-ink-500">+{project.data.stack.length - 5}</span>
                )}
              </div>
              <span class="shrink-0 font-mono text-sm text-ink-500 transition-all group-hover:translate-x-1 group-hover:text-signal-400" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- En cours au lab -->
    {comingSoonProjects.length > 0 && (
      <section class="space-y-5" id="comingSoonSection">
        <h2 class="flex items-center gap-2 border-b border-ink-800 pb-3 font-mono text-xs uppercase tracking-[0.18em] text-amberlab">
          <span class="h-1.5 w-1.5 rounded-full bg-amberlab"></span>
          <span>En cours au Lab</span>
          <span class="text-amberlab/60">({comingSoonProjects.length})</span>
        </h2>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2" id="comingSoonList">
          {comingSoonProjects.map((project: CollectionEntry<'projects'>) => (
            <a
              href={`/projects/${project.slug}`}
              data-categories={JSON.stringify(project.data.categories)}
              class="project-item card group flex flex-col border-dashed p-5 transition-colors hover:border-amberlab/50 sm:p-6"
            >
              <div class="mb-3 flex items-center justify-between gap-2 font-mono text-[11px] text-ink-500">
                <span class="chip-amber py-0">Bientôt disponible</span>
                <span>{project.data.year}</span>
              </div>

              <h3 class="mb-2.5 text-balance font-display text-lg font-semibold leading-snug text-ink-200 transition-colors group-hover:text-amberlab">
                {project.data.title}
              </h3>

              <p class="mb-5 text-sm leading-relaxed text-ink-400">
                {project.data.description}
              </p>

              <div class="mt-auto flex flex-wrap gap-1.5">
                {project.data.stack.slice(0, 5).map((tech: string) => (
                  <span class="chip">{tech}</span>
                ))}
                {project.data.stack.length > 5 && (
                  <span class="px-1 py-0.5 font-mono text-[11px] text-ink-500">+{project.data.stack.length - 5}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <style>
    .filter-btn {
      @apply cursor-pointer whitespace-nowrap rounded-full px-3.5 py-1.5 text-ink-400 transition-colors hover:text-ink-100;
    }
    .filter-btn.is-active {
      @apply bg-signal-400 font-medium text-ink-950 hover:text-ink-950;
    }
  </style>

  <!-- Filtrage côté client -->
  <script>
    const filterBtns = document.querySelectorAll('.filter-btn');
    const projectItems = document.querySelectorAll<HTMLElement>('.project-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');

        const selectedCat = btn.getAttribute('data-category');

        projectItems.forEach((item) => {
          const itemCategories: string[] = JSON.parse(item.getAttribute('data-categories') || '[]');
          const visible = selectedCat === 'all' || itemCategories.includes(selectedCat || '');
          item.style.display = visible ? '' : 'none';
        });
      });
    });
  </script>
</Layout>
