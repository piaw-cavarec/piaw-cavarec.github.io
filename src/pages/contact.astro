---
import Layout from '../layouts/Layout.astro';

const direct = [
  {
    label: 'Email',
    value: 'cavarec.piaw@gmail.com',
    href: 'mailto:cavarec.piaw@gmail.com',
    action: 'Envoyer un email ↗',
    actionHref: 'mailto:cavarec.piaw@gmail.com?subject=Contact%20Portfolio%20-%20Piaw%20CAVAREC',
    external: false,
    primary: true,
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/piaw-cavarec',
    href: 'https://linkedin.com/in/piaw-cavarec',
    action: 'Voir le profil ↗',
    actionHref: 'https://linkedin.com/in/piaw-cavarec',
    external: true,
  },
  {
    label: 'Localisation',
    value: 'Rennes, France',
    note: 'Mobilité France entière & Int.',
  },
];

const terms = [
  { label: 'Durée', value: '6 mois à temps plein', note: "Stage de fin d'études (Bac+5)" },
  { label: 'Période', value: 'Février 2027 – Juillet/Août 2027', note: 'Démarrage Février 2027' },
];
---

<Layout title="Me Contacter — Piaw CAVAREC" description="Contactez Piaw CAVAREC pour toute opportunité de stage de fin d'études en Audit Hardware, Sécurité des Systèmes Embarqués ou Rétro-ingénierie.">
  <div class="shell py-10 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">

      <!-- En-tête -->
      <header class="reveal space-y-6 lg:sticky lg:top-24 lg:self-start">
        <div class="inline-flex max-w-full items-center gap-2.5 rounded-full border border-ink-700 bg-ink-900/80 px-3 py-1.5 font-mono text-[11px] leading-snug text-ink-200 xs:text-xs">
          <span class="status-dot"></span>
          <span class="break-words">Disponible pour Stage — Février 2027</span>
        </div>

        <h1 class="font-display text-4xl font-semibold text-ink-100 sm:text-5xl lg:text-6xl">
          Me <span class="text-signal-400">Contacter</span>
        </h1>

        <p class="max-w-xl text-sm leading-relaxed text-ink-300 sm:text-base">
          Élève-ingénieur en dernière année à l'<strong class="text-ink-100">EPITA (Bac+5, Majeure SecDevOps)</strong>, je suis activement à la recherche d'un stage de fin d'études de <strong class="text-ink-100">6 mois à partir de Février 2027</strong> uniquement dans les domaines de l'<strong class="text-ink-100">Audit Hardware, la Sécurité des Systèmes Embarqués et la Rétro-ingénierie</strong>.
        </p>

        <div class="flex flex-col gap-3 xs:flex-row">
          <a href="mailto:cavarec.piaw@gmail.com?subject=Contact%20Portfolio%20-%20Piaw%20CAVAREC" class="btn-primary">
            Envoyer un email <span aria-hidden="true">↗</span>
          </a>
          <a href="/" class="btn-ghost">← Retour à l'accueil</a>
        </div>
      </header>

      <div class="space-y-6">
        <!-- Coordonnées directes -->
        <section class="card overflow-hidden">
          <h2 class="border-b border-ink-800 px-5 py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-500 sm:px-6">
            Coordonnées Directes
          </h2>
          <ul class="divide-y divide-ink-800/80">
            {direct.map((d) => (
              <li class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                <div class="min-w-0 space-y-1">
                  <div class="font-mono text-[11px] uppercase tracking-wider text-ink-500">{d.label}</div>
                  {d.href ? (
                    <a href={d.href} target={d.external ? '_blank' : undefined} rel={d.external ? 'noopener' : undefined} class="break-all font-mono text-sm font-medium text-ink-100 transition-colors hover:text-signal-300 xs:break-normal">
                      {d.value}
                    </a>
                  ) : (
                    <div class="font-mono text-sm font-medium text-ink-100">{d.value}</div>
                  )}
                </div>
                {d.actionHref ? (
                  <a href={d.actionHref} target={d.external ? '_blank' : undefined} rel={d.external ? 'noopener' : undefined} class={d.primary ? 'btn-primary shrink-0 px-3 py-2' : 'btn-ghost shrink-0 px-3 py-2'}>
                    {d.action}
                  </a>
                ) : (
                  <span class="chip shrink-0 justify-center px-3 py-1.5">{d.note}</span>
                )}
              </li>
            ))}
          </ul>
        </section>

        <!-- Modalités du stage -->
        <section class="card overflow-hidden">
          <h2 class="border-b border-ink-800 px-5 py-3 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-500 sm:px-6">
            Modalités du Stage
          </h2>
          <ul class="divide-y divide-ink-800/80">
            {terms.map((t) => (
              <li class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                <div class="space-y-1">
                  <div class="font-mono text-[11px] uppercase tracking-wider text-ink-500">{t.label}</div>
                  <div class="font-mono text-sm font-medium text-ink-100">{t.value}</div>
                </div>
                <span class="chip shrink-0 justify-center px-3 py-1.5">{t.note}</span>
              </li>
            ))}
            <li class="space-y-2 px-5 py-4 sm:px-6">
              <div class="font-mono text-[11px] uppercase tracking-wider text-ink-500">Domaines</div>
              <div class="flex flex-wrap gap-2">
                <span class="chip-accent">Audit Hardware & Micrologiciels</span>
                <span class="chip-accent">Sécurité Embarquée</span>
                <span class="chip-accent">Rétro-ingénierie</span>
              </div>
            </li>
          </ul>
          <div class="signal-trace opacity-40"></div>
        </section>
      </div>

    </div>
  </div>
</Layout>
