---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Me Contacter — Piaw CAVAREC" description="Contactez Piaw CAVAREC pour toute opportunité de stage de fin d'études en Audit Hardware, Sécurité des Systèmes Embarqués ou Rétro-ingénierie.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-16 space-y-8 sm:space-y-12">
    
    <!-- Header -->
    <header class="space-y-3.5 sm:space-y-4">
      <div class="inline-flex items-center gap-2 border border-zinc-800 bg-zinc-900/50 px-3 py-1.5 rounded-full text-[11px] xs:text-xs font-mono text-zinc-300 max-w-full leading-snug">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
        <span class="break-words">Disponible pour Stage — Février 2027</span>
      </div>

      <h1 class="text-3xl xs:text-4xl font-semibold text-zinc-100 tracking-tight">
        Me Contacter
      </h1>

      <p class="text-xs xs:text-sm sm:text-base text-zinc-300 leading-relaxed max-w-2xl font-sans">
        Élève-ingénieur en dernière année à l'<strong>EPITA (Bac+5, Majeure SecDevOps)</strong>, je suis activement à la recherche d'un stage de fin d'études de <strong>6 mois à partir de Février 2027</strong> uniquement dans les domaines de l'<strong>Audit Hardware, la Sécurité des Systèmes Embarqués et la Rétro-ingénierie</strong>.
      </p>
    </header>

    <!-- Main Contact Cards -->
    <div class="grid gap-6">
      
      <!-- Direct Contact Card -->
      <div class="border border-zinc-900 bg-zinc-900/30 p-4 xs:p-6 sm:p-8 rounded-xl space-y-5 sm:space-y-6">
        <h2 class="text-xs font-mono text-zinc-500 uppercase tracking-widest">Coordonnées Directes</h2>

        <div class="space-y-3 sm:space-y-4 font-mono text-xs sm:text-sm">
          <!-- Email -->
          <div class="flex flex-col xs:flex-row xs:items-center justify-between gap-3 p-3.5 sm:p-4 border border-zinc-900 bg-zinc-950/60 rounded-lg group">
            <div class="flex flex-col xs:flex-row xs:items-center gap-1.5 xs:gap-3 min-w-0">
              <span class="text-zinc-500 text-xs w-20 xs:w-24 sm:w-28 shrink-0">Email :</span>
              <a href="mailto:cavarec.piaw@gmail.com" class="text-zinc-100 font-semibold hover:underline decoration-zinc-700 underline-offset-4 break-all xs:break-normal text-xs sm:text-sm">
                cavarec.piaw@gmail.com
              </a>
            </div>
            <a 
              href="mailto:cavarec.piaw@gmail.com?subject=Contact%20Portfolio%20-%20Piaw%20CAVAREC" 
              class="text-xs text-zinc-400 group-hover:text-zinc-100 border border-zinc-800 hover:border-zinc-700 px-3 py-1.5 rounded transition-all text-center shrink-0 w-full xs:w-auto"
            >
              Envoyer un email ↗
            </a>
          </div>

          <!-- LinkedIn -->
          <div class="flex flex-col xs:flex-row xs:items-center justify-between gap-3 p-3.5 sm:p-4 border border-zinc-900 bg-zinc-950/60 rounded-lg group">
            <div class="flex flex-col xs:flex-row xs:items-center gap-1.5 xs:gap-3 min-w-0">
              <span class="text-zinc-500 text-xs w-20 xs:w-24 sm:w-28 shrink-0">LinkedIn :</span>
              <a href="https://linkedin.com/in/piaw-cavarec" target="_blank" rel="noopener" class="text-zinc-100 font-semibold hover:underline decoration-zinc-700 underline-offset-4 break-all xs:break-normal text-xs sm:text-sm">
                linkedin.com/in/piaw-cavarec
              </a>
            </div>
            <a 
              href="https://linkedin.com/in/piaw-cavarec" 
              target="_blank" 
              rel="noopener" 
              class="text-xs text-zinc-400 group-hover:text-zinc-100 border border-zinc-800 hover:border-zinc-700 px-3 py-1.5 rounded transition-all text-center shrink-0 w-full xs:w-auto"
            >
              Voir le profil ↗
            </a>
          </div>

          <!-- Location -->
          <div class="flex flex-col xs:flex-row xs:items-center justify-between gap-3 p-3.5 sm:p-4 border border-zinc-900 bg-zinc-950/60 rounded-lg">
            <div class="flex flex-col xs:flex-row xs:items-center gap-1.5 xs:gap-3">
              <span class="text-zinc-500 text-xs w-20 xs:w-24 sm:w-28 shrink-0">Localisation :</span>
              <span class="text-zinc-100 font-semibold text-xs sm:text-sm">Rennes, France</span>
            </div>
            <span class="text-[11px] xs:text-xs text-zinc-400 border border-zinc-800 bg-zinc-900/50 px-3 py-1.5 rounded shrink-0 text-center xs:text-left w-full xs:w-auto">
              Mobilité France entière & Int.
            </span>
          </div>
        </div>
      </div>

      <!-- Stage & Contract Details -->
      <div class="border border-zinc-900 bg-zinc-900/30 p-4 xs:p-6 sm:p-8 rounded-xl space-y-5 sm:space-y-6">
        <h2 class="text-xs font-mono text-zinc-500 uppercase tracking-widest">Modalités du Stage</h2>
        
        <div class="space-y-3 sm:space-y-4 font-mono text-xs sm:text-sm">
          <!-- Durée -->
          <div class="flex flex-col xs:flex-row xs:items-center justify-between gap-3 p-3.5 sm:p-4 border border-zinc-900 bg-zinc-950/60 rounded-lg">
            <div class="flex flex-col xs:flex-row xs:items-center gap-1.5 xs:gap-3">
              <span class="text-zinc-500 text-xs w-20 xs:w-24 sm:w-28 shrink-0">Durée :</span>
              <span class="text-zinc-100 font-semibold text-xs sm:text-sm">6 mois à temps plein</span>
            </div>
            <span class="text-[11px] xs:text-xs text-zinc-400 border border-zinc-800 bg-zinc-900/50 px-3 py-1.5 rounded shrink-0 text-center xs:text-left w-full xs:w-auto">
              Stage de fin d'études (Bac+5)
            </span>
          </div>

          <!-- Période -->
          <div class="flex flex-col xs:flex-row xs:items-center justify-between gap-3 p-3.5 sm:p-4 border border-zinc-900 bg-zinc-950/60 rounded-lg">
            <div class="flex flex-col xs:flex-row xs:items-center gap-1.5 xs:gap-3">
              <span class="text-zinc-500 text-xs w-20 xs:w-24 sm:w-28 shrink-0">Période :</span>
              <span class="text-zinc-100 font-semibold text-xs sm:text-sm">Février 2027 – Juillet/Août 2027</span>
            </div>
            <span class="text-[11px] xs:text-xs text-zinc-400 border border-zinc-800 bg-zinc-900/50 px-3 py-1.5 rounded shrink-0 text-center xs:text-left w-full xs:w-auto">
              Démarrage Février 2027
            </span>
          </div>

          <!-- Domaines ciblés -->
          <div class="flex flex-col xs:flex-row xs:items-start justify-between gap-3 p-3.5 sm:p-4 border border-zinc-900 bg-zinc-950/60 rounded-lg">
            <div class="flex flex-col xs:flex-row xs:items-start gap-1.5 xs:gap-3">
              <span class="text-zinc-500 text-xs w-20 xs:w-24 sm:w-28 shrink-0 pt-0.5">Domaines :</span>
              <div class="text-zinc-100 font-semibold text-xs sm:text-sm leading-relaxed">
                Audit Hardware & Micrologiciels <span class="text-zinc-600">·</span> Sécurité Embarquée <span class="text-zinc-600">·</span> Rétro-ingénierie
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Quick Back to Home Button -->
    <div class="pt-2 sm:pt-4 text-center">
      <a href="/" class="inline-flex items-center justify-center gap-2 font-mono text-xs text-zinc-400 hover:text-zinc-100 border border-zinc-900 hover:border-zinc-700 px-4 py-2.5 rounded transition-colors w-full xs:w-auto">
        ← Retour à l'accueil
      </a>
    </div>

  </div>
</Layout>

